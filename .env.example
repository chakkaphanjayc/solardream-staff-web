# Canonical browser origins for the independent Staff Web application.
NEXT_PUBLIC_SITE_URL=https://solar-dream.org
NEXT_PUBLIC_ADMIN_URL=https://admin.solar-dream.org
SOLARDREAM_APP_SURFACE=staff
# Server-only Document Service bridge. Keep disabled until the Worker, private
# engine, migration, and service-to-service secret have passed smoke tests.
DOCUMENT_SERVICE_SIGNATURE_ENABLED=false
DOCUMENT_SERVICE_URL=http://127.0.0.1:8787
DOCUMENT_SERVICE_ORGANIZATION_ID=solardream
DOCUMENT_SERVICE_SHARED_SECRET=replace-with-server-only-document-service-secret
DOCUMENT_SERVICE_AUTH_ISSUER=solardream-staff-web
DOCUMENT_SERVICE_AUTH_AUDIENCE=solardream-document-service
PORT=3200
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Server-only database connection. Use the pooled URL for the app and the
# direct URL for migrations when the provider requires a separate endpoint.
DATABASE_URL=postgres://user:password@host:6543/database
DIRECT_URL=postgres://user:password@host:5432/database

# Comma-separated canonical site fields required before project creation.
SITE_PROJECT_REQUIRED_FIELDS=label,addressLine1,city,province,postalCode,country

# DiscourseConnect. Configure the same secret in Discourse as
# `discourse_connect_secret`, and set `discourse_connect_url` to
# `${NEXT_PUBLIC_SITE_URL}/api/auth/discourse-sso`.
DISCOURSE_FORUM_URL=https://forum.example.com
DISCOURSE_SSO_SECRET=replace-with-a-long-random-shared-secret

# Use Cloudflare's official always-pass keys for local browser/automation tests.
# Keep test mode disabled in production.
NEXT_PUBLIC_TURNSTILE_TEST_MODE=false
TURNSTILE_TEST_MODE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Shared Supabase session cookie. Leave empty when running only on localhost;
# set explicitly in production only when every subdomain is trusted.
AUTH_COOKIE_DOMAIN=.solar-dream.org

# Generate once with `openssl rand -base64 32`. Keep this identical across
# public/admin applications and rolling deployments; it is required at build
# time to keep Server Actions compatible between instances.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-aes-key
# Use the same release/commit identifier for the public and admin builds;
# change it whenever the deployed source changes.
NEXT_DEPLOYMENT_ID=replace-with-release-or-commit-id

# Optional temporary diagnostics for /api/health. Keep disabled in production.
HEALTH_DIAGNOSTICS=false

# Server-only salt used to hash IP addresses and user-agent strings in the
# append-only audit ledger. Never reuse this value for another purpose.
AUDIT_LOG_HASH_SALT=replace-with-a-long-random-secret

# Google Drive service account used only by server-side document actions.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-private-key\\n-----END PRIVATE KEY-----\\n"
# Optional Shared Drive destination folder for an additional Drive archive.
# Service accounts cannot upload to their My Drive root because they have no storage quota.
GOOGLE_DRIVE_SIGNED_PDF_FOLDER_ID=

# A PKCS#12 certificate included in the deployment's server filesystem.
# Keep the actual certificate outside public/ and out of source control.
PDF_SIGNING_P12_PATH=certificates/document-signing.p12
PDF_SIGNING_P12_PASSPHRASE=replace-with-a-secret-passphrase

# Server-only ERPNext credentials and the Project Template used by the
# signed-Quotation -> Sales Order -> Project Golden Thread.
ERPNEXT_BASE_URL=https://erp.yourdomain.com
ERPNEXT_API_KEY=replace-with-erpnext-api-key
ERPNEXT_API_SECRET=replace-with-erpnext-api-secret
ERPNEXT_COMPANY_NAME=Solar Dream Co., Ltd.
ERPNEXT_PAYMENT_MODE_OF_PAYMENT=Bank Transfer
ERPNEXT_INSTALLATION_ACTIVITY_TYPE=Installation
ERPNEXT_SOLAR_QC_ITEM_CODE=
DEFAULT_SOLAR_PROJECT_TEMPLATE=SolarDream Installation Template
# Optional ERPNext doctypes used by the automated post-handover warranty registrar.
ERPNEXT_WARRANTY_LEDGER_DOCTYPE=Warranty Ledger
ERPNEXT_WARRANTY_ASSET_DOCTYPE=Installation Note
# Optional ERPNext doctypes used by the Operations V2 gateway. Keep the
# defaults when using standard ERPNext doctypes; override them for custom
# DocTypes with matching fields.
ERPNEXT_SERIAL_DOCTYPE=Serial No
ERPNEXT_WARRANTY_CLAIM_DOCTYPE=Warranty Claim
ERPNEXT_MAINTENANCE_VISIT_DOCTYPE=Maintenance Visit
# Keep false until the ERPNext custom fields and credentials are verified.
# Field work remains local-first while this is disabled; queued installation
# events are retained and can be replayed after enabling the projection.
ERPNEXT_INSTALLATION_SYNC_ENABLED=false
# Enables the Frappe custom installation command API for the Staff outbox
# worker. Leave false until the custom app and ERPNext permissions are tested.
ERPNEXT_INSTALLATION_COMMANDS_ENABLED=false
# Listmonk template ID for the digital warranty onboarding email.
LISTMONK_TEMPLATE_WARRANTY_REGISTERED=
# Optional LINE LIFF URL. Falls back to the public localized warranty route.
NEXT_PUBLIC_LINE_LIFF_WARRANTY_URL=

# LINE Admin Console. Keep live mutations disabled in development and tests.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_LIVE_MUTATIONS_ENABLED=false
LINE_ALLOW_SIMULATED_WEBHOOKS=false
LINE_AUTOMATION_TIMEZONE=Asia/Bangkok
LINE_BUSINESS_HOURS_START=09
LINE_BUSINESS_HOURS_END=18

# Dify is called only from the server-side adapter. Use a 32-byte hex key or
# base64 value; never expose these settings as NEXT_PUBLIC variables.
DIFY_ENCRYPTION_KEY=replace-with-64-hex-character-key
DIFY_ALLOWED_HOSTS=your-dify.example.com
DIFY_ALLOW_PRIVATE_NETWORK=false
DIFY_ALLOW_INSECURE_HTTP=false

# Payment verification and multi-channel payment notifications.
EASYSLIP_API_KEY=replace-with-easyslip-api-key
EASYSLIP_RECEIVER_ACCOUNT=
EASYSLIP_RECEIVER_NAME=
COMPANY_BANK_ACCOUNT=
COMPANY_BANK_ACCOUNT_NAME=
DISCORD_PAYMENT_WEBHOOK_URL=
